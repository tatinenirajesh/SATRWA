{
  "cli": {
    "version": ">= 21.0.2",
    "appVersionSource": "remote"
  },

  "build": {

    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_BACKEND_URL": "https://api.satrwa.in"
      }
    },

    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_BACKEND_URL": "https://api.satrwa.in"
      },
      "android": {
        "buildType": "apk"
      }
    },

    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_BACKEND_URL": "https://api.satrwa.in"
      }
    }

  },

  "submit": {
    "production": {}
  }
}